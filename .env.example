# VirtuMate 本地配置模板
# 使用方法: 复制为 .env 并填入你自己的 API Key
#   cp .env.example .env

# MIMO API Key（ASR + TTS 云端模式）
# 前往 https://platform.xiaomimimo.com 注册获取
MIMO_API_KEY=your_mimo_api_key_here

# DeepSeek API Key（LLM 云端模式）
# 前往 https://platform.deepseek.com 注册获取
LLM_CLOUD_API_KEY=your_deepseek_api_key_here

# Agentic RAG 独立 LLM Agent（可选，默认复用 MIMO 配置）
# AGENTIC_RAG_LLM_MODEL=mimo-v2.5-pro
# AGENTIC_RAG_LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# AGENTIC_RAG_LLM_API_KEY=your_mimo_api_key_here
