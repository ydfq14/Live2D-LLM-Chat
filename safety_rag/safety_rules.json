  "rules": [
    {
      "id": "safe-001",
      "level": "high",
      "category": "suicide_selfharm",
      "description": "用户表达自杀意图、自残计划或严重厌世情绪",
      "indicators": {
        "keywords": [
          "自杀", "想死", "不想活了", "活着没意思", "结束生命", "跳楼",
          "割腕", "跳河", "上吊", "安眠药", "轻生", "厌世", "没意义",
          "活着痛苦", "死了算了", "不想活", "想不开", "活够了", "自残",
          "伤害自己", "结束这一切", "消失", "离开这个世界"
        ],
        "semantic_hints": [
          "结束生命的方法", "如何 painless 死亡", "不想继续活着",
          "感觉没有活下去的理由", "计划结束自己"
        ]
      },
      "response": {
        "action": "intercept",
        "template": "我注意到你现在可能很痛苦。请相信，你并不孤单，很多人都在关心你。\n\n如果你需要专业的支持，可以拨打：\n{{resources}}\n\n我在这儿陪着你，但心理咨询师能给你更好的帮助。你愿意试着联系一下吗？",
        "resources": [
          {"name": "心理援助热线", "number": "400-161-9995", "hours": "24小时"},
          {"name": "北京危机干预热线", "number": "010-82951332", "hours": "24小时"},
          {"name": "生命热线", "number": "400-821-1215", "hours": "24小时"}
        ]
      },
      "metadata": {
        "log_required": true,
        "store_to_memory": false,
        "escalation": "care_team"
      }
    },
    {
      "id": "safe-002",
      "level": "high",
      "category": "violence_crime",
      "description": "用户涉及暴力、犯罪或违法行为的询问或陈述",
      "indicators": {
        "keywords": [
          "杀人", "怎么杀人", "杀了他", "武器", "炸弹", "爆炸物",
          "抢劫", "敲诈", "勒索", "绑架", "拐卖", "强奸", "性骚扰",
          "虐待", "家暴", "殴打", "恐怖袭击", "制造武器"
        ],
        "semantic_hints": [
          "如何实施犯罪", "逃避法律的方法", "伤害他人的技巧",
          "非法获取武器", "策划暴力事件"
        ]
      },
      "response": {
        "action": "intercept",
        "template": "这个话题我不能参与讨论。如果你或他人正处于危险中，请立即拨打：\n{{resources}}\n\n如果有什么其他我可以帮你的，我在这里。",
        "resources": [
          {"name": "报警电话", "number": "110", "hours": "24小时"},
          {"name": "急救电话", "number": "120", "hours": "24小时"}
        ]
      },
      "metadata": {
        "log_required": true,
        "store_to_memory": false,
        "escalation": "security"
      }
    },
    {
