# --- Python 字节码缓存 ---
__pycache__/
*.pyc
*.pyo

# --- 本地模型缓存 ---
.models/
models/

# --- 本地 AI 模型（CosyVoice / SenseVoice）---
TTS_env/CosyVoice/*
!TTS_env/CosyVoice/.gitkeep

ASR_env/SenseVoice/*
!ASR_env/SenseVoice/.gitkeep

# --- Python 虚拟环境 / IDE ---
.venv/
.idea/
.vscode/settings.json

# --- 插件运行时数据 ---
plugins_data/
!plugins_data/.gitkeep

# --- 本地密钥文件 ---
.env

# --- 运行时日志 ---
logs/*.log
!logs/.gitkeep

# --- TTS 生成音频 ---
TTS_env/output_voice/*.wav
TTS_env/output_voice_text.txt
!TTS_env/output_voice/.gitkeep

# --- TTS 历史音频 ---
TTS_env/voice_history/*.wav

# --- TTS 临时文件 ---
TTS_env/tmp/*
!TTS_env/tmp/.gitkeep

# --- ASR 输入音频 ---
ASR_env/input_voice/*.wav

# --- LLM 对话记录 ---
LLM_env/conversation_history.txt

# --- 插件数据目录 ---
!plugins_data/.gitkeep
.vscode/settings.json

models/
# --- 安全数据库（Chroma 向量库）---
safety_db/